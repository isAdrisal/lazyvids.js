{
  "name": "lazyvids",
  "version": "0.2.3",
  "description": "A small utility to lazy-load autoplay HTML5 videos once they enter the viewport.",
  "main": "dist/lazyvids.js",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isAdrisal/lazyvids.js.git"
  },
  "author": "isAdrisal",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/isAdrisal/lazyvids.js/issues"
  },
  "homepage": "https://github.com/isAdrisal/lazyvids.js#readme",
  "scripts": {
    "postinstall": "npx playwright install --with-deps",
    "build": "esbuild src/lazyvids.js --target=safari12",
    "build:dev": "rm -rf dev/*.js && npm run build -- --outdir=dev --log-level=warning",
    "build:prod": "rm -rf dist && npm run build -- --outdir=dist --minify",
    "start": "npm run build:dev -s -- --watch=forever & node dev.js",
    "test": "npm run build:dev && web-test-runner test/**/*.test.{html,js} --node-resolve --playwright --browsers chromium",
    "deploy": "npm run build:prod && npm publish"
  },
  "devDependencies": {
    "@esm-bundle/chai": "^4.3.4-fix.0",
    "@hono/node-server": "^1.11.3",
    "@web/test-runner": "^0.18.2",
    "@web/test-runner-mocha": "^0.9.0",
    "@web/test-runner-playwright": "^0.11.0",
    "esbuild": "^0.21.5",
    "hono": "^4.4.7"
  },
  "prettier": {
    "arrowParens": "always",
    "trailingComma": "es5",
    "semi": true,
    "tabWidth": 2,
    "singleQuote": true,
    "printWidth": 120,
    "proseWrap": "never"
  }
}
